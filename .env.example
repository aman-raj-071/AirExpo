# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AQICN_API_TOKEN: Server-only token from https://aqicn.org/data-platform/token/
# Required for location-by-location AQI station markers on the satellite map.
AQICN_API_TOKEN="YOUR_AQICN_TOKEN"

# OpenRouteService key used only by the server-side /api/routes proxy.
OPENROUTESERVICE_API_KEY="YOUR_OPENROUTESERVICE_KEY"

# Google Maps JavaScript browser key. Restrict this key to your deployed web
# origins and enable Maps JavaScript API. Used by the jogging satellite map.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_BROWSER_KEY"

# Cognito user pool and public app client IDs. These identifiers are not secrets.
# Deploy infra/template.yaml, then copy the stack outputs into .env.local.
VITE_COGNITO_USER_POOL_ID="us-east-1_UOugaJlN8"
VITE_COGNITO_USER_POOL_CLIENT_ID="6rls971j2qq88nune9f74lukbc"

# AWS SNS direct SMS: server only. IAM role or AWS_PROFILE supplies credentials.
# In the SNS SMS sandbox, list each verified E.164 destination separated by commas.
AWS_REGION="us-east-1"
SNS_REGION="us-east-1"
SNS_SMS_RECIPIENTS="+1XXXXXXXXXX,+1YYYYYYYYYY"

# DynamoDB/S3 local server integration (never prefix these with VITE_)
SETTINGS_TABLE=""
PROFILE_TABLE=""
SYMPTOM_TABLE=""
DOCUMENT_TABLE=""
CONVERSATION_TABLE=""
REMINDER_TABLE=""
REPORT_BUCKET=""
# Health Assistant calls Gemini only on the server. Tell users in the Health UI
# before sharing any report or health context. Never prefix these with VITE_.
AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.8-flash"
# AWS_REGION and AWS_PROFILE/IAM role must allow access to these resources.
# Optional: deployed API Gateway URL instead of local Express /api/cloud
VITE_STORAGE_API_URL=""

# AQI forecasting: local Python model or deployed SageMaker endpoint.
AQI_INFERENCE_PROVIDER="local"
SAGEMAKER_ENDPOINT_NAME=""
PYTHON_BIN="python"

# Cognito managed login (public domain and callback URL)
VITE_COGNITO_DOMAIN="us-east-1uougajln8.auth.us-east-1.amazoncognito.com"
VITE_COGNITO_REDIRECT_URI="https://d84l1y8p4kdic.cloudfront.net"

VITE_COGNITO_REGION="us-east-1"
# Auth backend base URL: empty for Express/same-origin CloudFront /api/*.
# Set to an HTTPS API Gateway/backend origin for a separately hosted API.
VITE_AUTH_API_URL="https://xsvjrx04tl.execute-api.us-east-1.amazonaws.com"
# Server-only auth overrides (defaults to the public VITE_COGNITO_* settings)
# COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, COGNITO_DOMAIN, COGNITO_REDIRECT_URI
