{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishAirExpoSmsToVerifiedDestinations",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
